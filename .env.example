# CareDose+ Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it's already in .gitignore

# ─── Firebase Push Notifications (FCM) ───────────────────────────────────
# Get this from: Firebase Console → Project Settings → Cloud Messaging
#                → Web Push certificates → Generate key pair → Copy the string
VITE_FIREBASE_VAPID_KEY=

# ─── Google Fit OAuth ─────────────────────────────────────────────────────
# Your Client ID (already provided):
VITE_GOOGLE_FIT_CLIENT_ID=773546090775-m6397lr6kkft8rjllv7c7afrjgkn5fki.apps.googleusercontent.com

# ─── Fitbit OAuth (optional - only if you register at dev.fitbit.com) ────
# Registration details to use at https://dev.fitbit.com/apps/new :
#   Application Name: CareDose+
#   Description: Smart medication management for elderly care
#   Application Website: https://your-app.onrender.com
#   Organization: CareDose
#   Organization Website: https://your-app.onrender.com
#   Terms of Service URL: https://your-app.onrender.com
#   Privacy Policy URL: https://your-app.onrender.com
#   OAuth 2.0 Application Type: Personal (for testing) or Server
#   Callback URL: https://your-app.onrender.com/fitbit-callback
#   Default Access Type: Read-Only
# Then paste your Client ID here:
VITE_FITBIT_CLIENT_ID=
